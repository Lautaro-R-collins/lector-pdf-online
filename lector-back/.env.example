# Servidor
PORT=5000
NODE_ENV=development

# Base de Datos MongoDB (Local o MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/lector_pdf

# JSON Web Tokens (Secrets y Expiraciones)
JWT_ACCESS_SECRET=tu_secreto_super_seguro_para_access_token_min_32_chars
JWT_REFRESH_SECRET=tu_secreto_super_seguro_para_refresh_token_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URL del Frontend (CORS)
CLIENT_URL=http://localhost:5173
